# Generated by `xcodegen generate` — never commit these.
*.xcodeproj
*.xcworkspace
MenuLens/Info.plist

# Build artifacts. `build/` alone was not enough: xcodebuild was pointed at
# build-device/ and build-release/ too, and their ModuleCache .pcm files are
# tens of MB each — 190 MB of compiler cache had been committed before this
# was noticed.
DerivedData/
build*/
*.ipa
*.xcarchive/
*.dSYM.zip

# User state
xcuserdata/
*.xcuserstate
.DS_Store

# Secrets — never commit API keys
*.secret
.env

# Review-only secret, never commit
docs/review-key.local.md

# EU DSA trader 信息（含住址），never commit
docs/trader-info.local.md
